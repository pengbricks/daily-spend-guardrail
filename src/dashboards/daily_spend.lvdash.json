                  "fieldName": "yesterday_spend_usd",
                  "displayName": "Yesterday",
                  "format": {"type": "number-currency", "currencyCode": "USD", "abbreviation": "compact", "decimalPlaces": {"type": "max", "places": 2}}
                },
                "target": {"fieldName": "prior_day_spend_usd", "displayName": "vs prior day"}
              },
              "frame": {"showTitle": true, "title": "Yesterday's List Cost"}
            }
          },
          "position": {"x": 0, "y": 4, "width": 4, "height": 3}
        },
        {
          "widget": {
            "name": "seven-day-average",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_spend_summary",
                  "fields": [
                    {"name": "seven_day_avg_spend_usd", "expression": "`seven_day_avg_spend_usd`"}
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "seven_day_avg_spend_usd",
                  "displayName": "Daily average",
                  "format": {"type": "number-currency", "currencyCode": "USD", "abbreviation": "compact", "decimalPlaces": {"type": "max", "places": 2}}
                }
