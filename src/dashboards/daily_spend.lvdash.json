              "frame": {"showTitle": true, "title": "7-Day Daily Average"}
            }
          },
          "position": {"x": 4, "y": 4, "width": 4, "height": 3}
        },
        {
          "widget": {
            "name": "thirty-day-spend",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_spend_summary",
                  "fields": [
                    {"name": "thirty_day_spend_usd", "expression": "`thirty_day_spend_usd`"}
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "thirty_day_spend_usd",
                  "displayName": "30-day total",
                  "format": {"type": "number-currency", "currencyCode": "USD", "abbreviation": "compact", "decimalPlaces": {"type": "max", "places": 2}}
                }
              },
              "frame": {"showTitle": true, "title": "30-Day List Cost"}
            }
          },
          "position": {"x": 8, "y": 4, "width": 4, "height": 3}
        },
        {
          "widget": {
            "name": "daily-spend-trend",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_daily_spend",
                  "fields": [
                    {"name": "usage_date", "expression": "`usage_date`"},
                    {"name": "daily_spend_usd", "expression": "`daily_spend_usd`"}
