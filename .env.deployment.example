# Production deployment template. Keep the alert paused through acceptance testing.
DATABRICKS_PROFILE=production-workspace
DATABRICKS_TARGET=prod

BUNDLE_VAR_deployment_label="Finance Team"
BUNDLE_VAR_warehouse_id=0000000000000000
BUNDLE_VAR_daily_budget_usd=5000
BUNDLE_VAR_top_n=5
BUNDLE_VAR_alert_cron="0 0 9 * * ?"
BUNDLE_VAR_alert_timezone=America/New_York
BUNDLE_VAR_alert_pause_status=PAUSED
BUNDLE_VAR_alert_recipient_email=finops-owner@example.com
BUNDLE_VAR_alert_access_group=daily-spend-alert-users
