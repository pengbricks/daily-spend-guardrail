# Local development example. Copy to .env and replace every placeholder.
DATABRICKS_PROFILE=my-workspace-profile
DATABRICKS_TARGET=dev

BUNDLE_VAR_deployment_label="Finance Team"
BUNDLE_VAR_warehouse_id=0000000000000000
BUNDLE_VAR_daily_budget_usd=1000
BUNDLE_VAR_top_n=5
BUNDLE_VAR_alert_cron="0 0 9 * * ?"
BUNDLE_VAR_alert_timezone=America/Denver
BUNDLE_VAR_alert_pause_status=PAUSED
BUNDLE_VAR_alert_recipient_email=finops-owner@example.com
BUNDLE_VAR_alert_access_group=daily-spend-alert-recipients
